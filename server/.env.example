# Copy this file to .env and replace every placeholder.
# Never commit the resulting server/.env file.

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yume
DATABASE_SSL=false

# Sessions
# Generate a unique, high-entropy value for every environment.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=yume.sid
SESSION_TABLE=session

# Production only: number of trusted reverse proxies (normally 1).
TRUST_PROXY=1
