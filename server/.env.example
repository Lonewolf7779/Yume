# Copy this file to .env and replace every placeholder.
# Never commit the resulting server/.env file.

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yume
DATABASE_SSL=false

# Sessions
# Generate a unique, high-entropy value for every environment.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=yume.sid
SESSION_TABLE=session

# Production only: number of trusted reverse proxies (normally 1).
TRUST_PROXY=1

# fal image generation & transformation (server-only: never expose this in browser JavaScript)
# Create the key in your fal account and set it only in server/.env or your host's secret manager.
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1
FAL_TRANSFORM_MODEL=fal-ai/flux-pro/v1.1/redux

# Admin bootstrap
# Comma-separated email addresses that should have admin access after they sign out and back in.
# Keep this server-only. Example: ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=

# Media Storage Configuration (Cloudflare R2 / S3)
# Set STORAGE_PROVIDER=local for local development & CI.
# Set STORAGE_PROVIDER=s3 for Cloudflare R2 or AWS S3 persistent storage in production.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PRESIGNED_URLS=false

# Rate Limiting & Daily Quotas
MAX_DAILY_UPLOADS_PER_USER=20
MAX_DAILY_GENERATIONS_PER_USER=30
