# Server
PORT=3001
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://pinpin:pinpin@localhost:5432/pinpin
DATABASE_SSL=false

# Sessions (cookie-based)
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=pinpin.sid
SESSION_TABLE=session

# Optional: set to true to allow self-signed certs (if DATABASE_SSL=true)
# DATABASE_SSL=true
